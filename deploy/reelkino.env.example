# reelkino — конфиг (env). Файл лежит в /etc/reelkino/reelkino.env, mode 0600.

# Токен бота от @BotFather
TG_BOT_TOKEN=

# Токен api.kinopoisk.dev — получить у @kinopoiskdev_bot (бесплатный тариф)
KINOPOISK_API_TOKEN=

# Кому можно пользоваться ботом (tg id через запятую)
ALLOWED_TG_IDS=1919118841

# Куда слушает HTTP (Mini App), наружу ходит через Caddy
LISTEN_ADDR=127.0.0.1:8091

# Путь к SQLite
DB_PATH=/var/lib/reelkino/movies.db

# Публичный URL миниаппа
WEBAPP_URL=https://kino.vlle.ru/

# Ключ opencode Zen (https://opencode.ai/zen) — LLM для определения фильма по описанию рилса
ZEN_API_KEY=

# Модель Zen; пусто = deepseek-v4-flash-free (бесплатная)
ZEN_MODEL=

# Каталог со скачанными рилсами и превью
MEDIA_DIR=/var/lib/reelkino/media

# Путь до yt-dlp (скачивание рилсов)
YTDLP_PATH=/usr/local/bin/yt-dlp
